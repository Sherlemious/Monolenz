# Root-level Dockerfile for API
FROM node:20-alpine AS base
RUN corepack enable
WORKDIR /app

# Install dependencies stage
FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages ./packages
COPY apps/api/package.json ./apps/api/
RUN pnpm install --filter api... --filter "@monolenz/*" --frozen-lockfile

# Build stage
FROM base AS builder
WORKDIR /app

COPY --from=deps /app /app
COPY . .

# Create a dummy newrelic.cjs if it doesn't exist
RUN [ -f /app/apps/api/newrelic.cjs ] || printf "module.exports = {};\n" > /app/apps/api/newrelic.cjs

# Build packages first (required for @monolenz/types)
RUN pnpm --filter="@monolenz/*" build

# Generate Prisma client first (before building)
RUN cd apps/api && pnpm prisma generate

# Build the API and shared packages
RUN pnpm --filter api build:without-db

# Runtime stage
FROM node:20-alpine AS runner
RUN corepack enable
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8080

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 apiuser

# Copy built application
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /app/apps/api/newrelic.cjs ./apps/api/

# Copy shared packages (built)
COPY --from=builder /app/packages ./packages

# Copy generated Prisma client
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma

# Copy workspace files
COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-workspace.yaml ./
COPY --from=builder /app/pnpm-lock.yaml ./

# Install only production dependencies
RUN pnpm install --filter api... --prod --frozen-lockfile

# Ensure proper ownership
RUN chown -R apiuser:nodejs /app
USER apiuser

# Add health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD node -e "require('http').get('http://localhost:8080/health', (res) => process.exit(res.statusCode === 200 ? 0 : 1))"

WORKDIR /app/apps/api

# Start the application
CMD ["node", "dist/server.js"]