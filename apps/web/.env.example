# Leave empty so the browser (and server, in-process) uses same-origin /api/v1.
# For local Express: http://localhost:4000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=https://monolenz.sherlemious.com
AUTH_SECRET=generate_a_32+_character_random_string
# Local `next dev` only. On Cloudflare the Worker uses the HYPERDRIVE binding instead.
# Never commit or ship these: OpenNext bundles every .env* file into the Worker.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Used by wrangler for the HYPERDRIVE binding in `next dev` / `pnpm preview`
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Optional password-reset email
# RESEND_API_KEY=
# AUTH_FROM_EMAIL=Monolenz <noreply@monolenz.sherlemious.com>
# Optional AI (OpenAI-compatible; used by Next.js /api/v1). On Cloudflare set as Worker secrets.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# Optional analytics
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
