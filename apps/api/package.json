{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "exports": {
    "./core": "./src/core.ts"
  },
  "scripts": {
    "build": "pnpm i && prisma generate && tsup",
    "build:without-db": "pnpm i && tsup",
    "dev": "tsx watch src/server.ts --clear-screen=false",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:copy-to-neon": "tsx prisma/copy-to-neon.ts"
  },
  "dependencies": {
    "@monolenz/types": "workspace:*",
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.6.1",
    "jose": "^6.2.9",
    "morgan": "^1.10.0",
    "prisma": "^6.12.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@monolenz/eslint-config": "workspace:*",
    "@monolenz/typescript-config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.5.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.31.0",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.4",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
