{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "build": "pnpm i && prisma db pull && prisma generate && tsup",
    "dev": "tsx watch src/server.ts --clear-screen=false",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "openapi:generate": "tsx src/scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.1.0",
    "@monolenz/types": "workspace:*",
    "@prisma/client": "6.12.0",
    "@supabase/supabase-js": "^2.52.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.6.1",
    "morgan": "^1.10.0",
    "newrelic": "^13.0.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "yaml": "^2.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@monolenz/eslint-config": "workspace:*",
    "@monolenz/typescript-config": "workspace:*",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/morgan": "^1.9.4",
    "@types/newrelic": "^9.14.8",
    "@types/node": "^20.19.9",
    "prisma": "^6.12.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
