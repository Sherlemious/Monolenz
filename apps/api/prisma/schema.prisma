generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String        @unique @db.VarChar(255)
  password_hash     String
  email_verified_at DateTime?     @db.Timestamptz(6)
  role              String        @default("user") @db.VarChar(50)
  created_at        DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?     @default(now()) @db.Timestamptz(6)
  auth_tokens       auth_tokens[]
  profiles          profiles?
}

model auth_tokens {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  type       String   @db.VarChar(32)
  token_hash String   @unique @db.VarChar(64)
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, type])
}

model blocks {
  id                                                      Int                     @id @default(autoincrement())
  block_type                                              String                  @db.VarChar(50)
  content_hash                                            String                  @unique @db.VarChar(64)
  created_at                                              DateTime?               @default(now()) @db.Timestamptz(6)
  block_awards                                            block_awards?
  block_certifications                                    block_certifications?
  block_educations                                        block_educations?
  block_languages                                         block_languages?
  block_projects                                          block_projects?
  block_skills                                            block_skills?
  block_volunteers                                        block_volunteers?
  block_work_experiences                                  block_work_experiences?
  version_blocks_version_blocks_block_idToblocks          version_blocks[]        @relation("version_blocks_block_idToblocks")
  version_blocks_version_blocks_previous_block_idToblocks version_blocks[]        @relation("version_blocks_previous_block_idToblocks")
}

model profiles {
  id                  String          @id @db.Uuid
  username            String          @unique @db.VarChar(50)
  bio                 String?
  profile_picture_url String?         @db.VarChar(500)
  linkedin_url        String?         @db.VarChar(500)
  github_url          String?         @db.VarChar(500)
  portfolio_url       String?         @db.VarChar(500)
  theme               String?         @default("default") @db.VarChar(50)
  created_at          DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?       @default(now()) @db.Timestamptz(6)
  deleted_at          DateTime?       @db.Timestamptz(6)
  users               users           @relation(fields: [id], references: [id], onDelete: Cascade)
  profile_links       profile_links[]
  versions            versions[]
}

model link_platforms {
  id            Int             @id @default(autoincrement())
  name          String          @unique @db.VarChar(100)
  display_name  String          @db.VarChar(255)
  category      String?         @db.VarChar(100)
  icon          String?         @db.VarChar(100)
  base_url      String?         @db.VarChar(255)
  url_pattern   String?         @db.VarChar(255)
  is_active     Boolean?        @default(true)
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?       @default(now()) @db.Timestamptz(6)
  profile_links profile_links[]
}

model profile_links {
  id             Int             @id @default(autoincrement())
  profile_id     String          @db.Uuid
  platform_id    Int?
  url            String          @db.VarChar(500)
  label          String?         @db.VarChar(100)
  category       String?         @db.VarChar(100)
  is_public      Boolean?        @default(true)
  sort_order     Int?            @default(0)
  created_at     DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?       @default(now()) @db.Timestamptz(6)
  link_platforms link_platforms? @relation(fields: [platform_id], references: [id])
  profiles       profiles        @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([profile_id, is_public], map: "idx_profile_links_profile_public")
}

model version_blocks {
  version_id                                            Int
  block_id                                              Int
  previous_block_id                                     Int?
  is_visible                                            Boolean?  @default(true)
  section_name                                          String?   @db.VarChar(255)
  sort_order                                            Int?      @default(0)
  created_at                                            DateTime? @default(now()) @db.Timestamptz(6)
  previous_version_id                                   Int?
  blocks_version_blocks_block_idToblocks                blocks    @relation("version_blocks_block_idToblocks", fields: [block_id], references: [id], onDelete: Cascade)
  blocks_version_blocks_previous_block_idToblocks       blocks?   @relation("version_blocks_previous_block_idToblocks", fields: [previous_block_id], references: [id])
  versions_version_blocks_previous_version_idToversions versions? @relation("version_blocks_previous_version_idToversions", fields: [previous_version_id], references: [id])
  versions_version_blocks_version_idToversions          versions  @relation("version_blocks_version_idToversions", fields: [version_id], references: [id], onDelete: Cascade)

  @@id([version_id, block_id])
}

model versions {
  id                                                          Int              @id @default(autoincrement())
  profile_id                                                  String?          @db.Uuid
  parent_version_id                                           Int?
  name                                                        String?          @db.VarChar(255)
  description                                                 String?
  created_at                                                  DateTime?        @default(now()) @db.Timestamptz(6)
  metadata                                                    Json?            @default("{}")
  version_blocks_version_blocks_previous_version_idToversions version_blocks[] @relation("version_blocks_previous_version_idToversions")
  version_blocks_version_blocks_version_idToversions          version_blocks[] @relation("version_blocks_version_idToversions")
  versions                                                    versions?        @relation("versionsToversions", fields: [parent_version_id], references: [id])
  other_versions                                              versions[]       @relation("versionsToversions")
  profiles                                                    profiles?        @relation(fields: [profile_id], references: [id], onDelete: Cascade)
}

model block_awards {
  block_id      Int       @id
  title         String    @db.VarChar(255)
  issuer        String?   @db.VarChar(255)
  date_received DateTime? @db.Date
  description   String?
  url           String?   @db.VarChar(500)
  blocks        blocks    @relation(fields: [block_id], references: [id], onDelete: Cascade)
}

model block_certifications {
  block_id             Int       @id
  name                 String    @db.VarChar(255)
  issuing_organization String    @db.VarChar(255)
  organization_url     String?   @db.VarChar(500)
  credential_id        String?   @db.VarChar(255)
  credential_url       String?   @db.VarChar(500)
  issue_date           DateTime? @db.Date
  expiration_date      DateTime? @db.Date
  does_not_expire      Boolean?  @default(false)
  blocks               blocks    @relation(fields: [block_id], references: [id], onDelete: Cascade)
}

model block_educations {
  block_id            Int       @id
  institution_name    String    @db.VarChar(255)
  institution_url     String?   @db.VarChar(500)
  degree_type         String?   @db.VarChar(50)
  degree_name         String?   @db.VarChar(255)
  field_of_study      String?   @db.VarChar(255)
  start_date          DateTime? @db.Date
  end_date            DateTime? @db.Date
  is_current          Boolean?  @default(false)
  gpa                 Decimal?  @db.Decimal(3, 2)
  gpa_scale           Decimal?  @default(4.0) @db.Decimal(3, 1)
  honors              String[]
  relevant_coursework String[]
  location            String?   @db.VarChar(255)
  blocks              blocks    @relation(fields: [block_id], references: [id], onDelete: Cascade)
}

model block_languages {
  block_id    Int    @id
  language    String @db.VarChar(100)
  proficiency String @db.VarChar(50)
  blocks      blocks @relation(fields: [block_id], references: [id], onDelete: Cascade)
}

model block_projects {
  block_id       Int       @id
  name           String    @db.VarChar(255)
  description    String?
  url            String?   @db.VarChar(500)
  repository_url String?   @db.VarChar(500)
  image_url      String?   @db.VarChar(500)
  start_date     DateTime? @db.Date
  end_date       DateTime? @db.Date
  is_ongoing     Boolean?  @default(false)
  technologies   String[]
  highlights     String[]
  blocks         blocks    @relation(fields: [block_id], references: [id], onDelete: Cascade)
}

model block_skills {
  block_id          Int      @id
  name              String   @db.VarChar(255)
  category          String   @db.VarChar(50)
  proficiency_level String?  @db.VarChar(50)
  years_experience  Decimal? @db.Decimal(4, 1)
  blocks            blocks   @relation(fields: [block_id], references: [id], onDelete: Cascade)
}

model block_volunteers {
  block_id          Int       @id
  organization_name String    @db.VarChar(255)
  role              String    @db.VarChar(255)
  cause             String?   @db.VarChar(255)
  start_date        DateTime? @db.Date
  end_date          DateTime? @db.Date
  is_current        Boolean?  @default(false)
  description       String?
  highlights        String[]
  blocks            blocks    @relation(fields: [block_id], references: [id], onDelete: Cascade)
}

model block_work_experiences {
  block_id         Int       @id
  company_name     String    @db.VarChar(255)
  company_url      String?   @db.VarChar(500)
  company_logo_url String?   @db.VarChar(500)
  position_title   String    @db.VarChar(255)
  employment_type  String?   @db.VarChar(50)
  location         String?   @db.VarChar(255)
  location_type    String?   @db.VarChar(50)
  start_date       DateTime  @db.Date
  end_date         DateTime? @db.Date
  is_current       Boolean?  @default(false)
  description      String?
  achievements     String[]
  technologies     String[]
  blocks           blocks    @relation(fields: [block_id], references: [id], onDelete: Cascade)
}
