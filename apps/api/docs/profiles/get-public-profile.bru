meta {
  name: Get Public Profile
  type: http
  seq: 6
}

get {
  url: {{v1link}}/profiles/public/:identifier
  body: none
  auth: none
}

params:path {
  identifier: johndoe
}

docs {
  # Get Public Profile
  
  Retrieves the public view of a profile. No authentication required.
  Returns limited data appropriate for public viewing.
  
  ## Path Parameters
  
  | Parameter | Type | Description |
  |-----------|------|-------------|
  | `identifier` | string | Profile ID (UUID) or username |
  
  ## Response (200 OK)
  ```json
  {
    "success": true,
    "message": "Public profile retrieved successfully",
    "data": {
      "username": "johndoe",
      "bio": "Full-stack developer...",
      "profile_picture_url": "https://example.com/avatar.jpg",
      "portfolio_url": "https://johndoe.dev"
    }
  }
  ```
  
  ## Error Response (404)
  ```json
  {
    "success": false,
    "message": "Profile not found"
  }
  ```
}
