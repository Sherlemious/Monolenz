// Meta
API_VERSION=1.0.0
LOG_LEVEL=info

// Database (Neon Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

// Auth
AUTH_SECRET=generate_a_32+_character_random_string
PUBLIC_SITE_URL=http://localhost:3000
# Optional password-reset email (https://resend.com)
# RESEND_API_KEY=
# AUTH_FROM_EMAIL=Monolenz <noreply@example.com>

// New Relic
NEW_RELIC_APP_NAME="monolenz api"
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key_here
NEW_RELIC_LOG_LEVEL=info

// CORS
ALLOWED_ORIGINS=http://localhost:3000,https://monolenz.sherlemious.com

// Redis
REDIS_URL=redis://localhost:6379
