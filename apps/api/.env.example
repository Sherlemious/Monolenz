// Meta
API_VERSION=1.0.0
LOG_LEVEL=info

// Database (Neon Postgres)
# Pooled (-pooler) for app traffic, direct for Prisma Migrate. `neon env pull` writes both.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

// Auth
AUTH_SECRET=generate_a_32+_character_random_string
PUBLIC_SITE_URL=http://localhost:3000
# Optional password-reset email (https://resend.com)
# RESEND_API_KEY=
# AUTH_FROM_EMAIL=Monolenz <noreply@example.com>

# Optional AI (OpenAI-compatible: OpenAI, Groq, OpenRouter, Ollama, …)
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

// Redis
REDIS_URL=redis://localhost:6379
